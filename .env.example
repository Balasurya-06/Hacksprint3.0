# Copy to .env.local (never commit real values). On Vercel, add these under Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=https://www.hacksprint.tech

# Postgres connection string (Supabase: Project Settings → Database → Connection string → "Transaction pooler")
DATABASE_URL=postgresql://user:password@host:6543/postgres
# DATABASE_SSL=false   # only for a local Postgres without SSL

# Long random string, signs login cookies and entry-pass QR codes.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Password for /admin/finalists
ADMIN_PASSWORD=

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you set for https://<domain>/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# Fee per member in rupees
FINALIST_FEE_PER_MEMBER=300

# SMTP for mails (Gmail: smtp.gmail.com, port 465, user = the Gmail address, pass = an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hacksprint.official@gmail.com
SMTP_PASS=
MAIL_FROM="HackSprint 3.0 <hacksprint.official@gmail.com>"
